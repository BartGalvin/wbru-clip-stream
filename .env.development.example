# Optional snapshot development. Copy to .env.development.local and fill in your host.
# Configure non-interactive SSH. Use dev:api and dev:web for local clips.
DEV_SSH_HOST=
DEV_REMOTE_APP_DIR=
DEV_REMOTE_ENV_FILE=

# Media host:port as reached from the SSH host.
DEV_MEDIA_REMOTE=

# Local development ports.
DEV_MEDIA_PORT=8767
DEV_WEB_PORT=5174
