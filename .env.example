# Optional media endpoints. Copy to ignored .env; blank radio URLs disable external audio.
RADIO_INDIE_URL=
RADIO_360_URL=
YOUTUBE_CHANNEL_URL=

# Deployment targets. Set these for your own installation.
WBRU_SSH_USER=
WBRU_VISUALIZER_HOST=
WBRU_TV_HOST=

# Optional path overrides. Blank values use the deployment script defaults.
WBRU_APP_DIR=
WBRU_CLIPS_DIR=
WBRU_REMOTE_ENV_FILE=
WBRU_ROLLBACK_DIR=

# Service scope: system or user.
WBRU_SERVICE_SCOPE=system

# Optional public origin overrides.
WBRU_VISUALIZER_ORIGIN=
WBRU_TV_ORIGIN=
