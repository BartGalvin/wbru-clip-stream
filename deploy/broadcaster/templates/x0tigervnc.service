[Unit]
Description=TigerVNC access to the OBS desktop
After=lightdm.service
Requires=lightdm.service
PartOf=lightdm.service
StartLimitIntervalSec=0

[Service]
Type=simple
User={{OBS_USER}}
Environment=DISPLAY=:0
Environment=XAUTHORITY={{OBS_HOME}}/.Xauthority
ExecStartPre=/usr/bin/test -S /tmp/.X11-unix/X0
ExecStart=/usr/bin/X0tigervnc -display :0 -rfbport {{VNC_PORT}} -localhost -SecurityTypes VncAuth -PasswordFile {{OBS_HOME}}/.vnc/passwd -AlwaysShared -AcceptKeyEvents -AcceptPointerEvents -FrameRate 30
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
