[Unit]
Description=Snapshot WBRU program database
After=network.target

[Service]
Type=oneshot
WorkingDirectory="{{WBRU_APP_DIR}}"
Environment=PATH=/usr/bin:/usr/local/bin:/bin
EnvironmentFile=/etc/wbru-visualizer.env
# Keep one day of 15-minute snapshots locally; send them off-box for longer retention.
Environment=KEEP=96
ExecStart=/usr/bin/env node scripts/backup-data.mjs
User=www-data
