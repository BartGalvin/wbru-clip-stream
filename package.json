{
  "name": "wbru-visualizer",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:pull": "node scripts/dev.mjs pull",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "fetch": "node scripts/fetch.mjs",
    "sync-youtube": "node --env-file-if-exists=.env scripts/sync-youtube.mjs",
    "live": "node scripts/live.mjs",
    "index-clips": "node scripts/index-clips.mjs",
    "thumbnails": "node --env-file-if-exists=.env scripts/generate-thumbnails.mjs",
    "backup": "node scripts/backup-data.mjs",
    "deploy-code": "bash deploy/deploy-code.sh",
    "sync-clips": "bash deploy/sync-clips.sh",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "tsx --env-file-if-exists=.env server/src/index.ts",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json && svelte-check --tsconfig ./tsconfig.json",
    "pretest": "node scripts/check-node.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html,svelte}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "hls.js": "^1.6.16",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
